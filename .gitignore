# Codeless repo — per-repo ignores. The workspace-level .gitignore in
# the parent codeless-workspace repo handles workspace concerns
# (e.g. inner repos as colocated, vendored ai-runner footguns).

# Cargo build output
target/
Cargo.lock.bak

# SQLite databases produced by the runtime
*.db
*.db-journal
*.db-wal
*.db-shm

# Worktree dirs created by codeless-adapters-host's worktree manager
worktrees/

# Per-repo runtime scratch space — `codeless serve` defaults
# --worktree-root to <fs-root>/.codeless/worktrees when --fs-root is
# set, and Phase 2 templates land at .codeless/jobs/<slug>.yaml.
# Templates are explicitly opt-in (the user wants those committed),
# but worktrees and any future scratch should never be tracked.
.codeless/worktrees/

# Local dev orchestration scratch space written by the top-level Makefile
# (codeless/Makefile): pid files, dev SQLite, backend/ui log files.
.codeless-dev/

# Local loop job scratch directories
job-01KRSKS8XYAW47SR6F1GXAWH9F/

# Secrets / local config
.env
.env.*
!.env.example
auth.toml
secrets.toml

# Audit and runtime logs
*.log
audit.log*

# Frontend (Phase 3 onwards)
node_modules/
dist/
.next/

# Editor / IDE
.idea/
.vscode/
*.swp
*.swo

# OS junk
.DS_Store
Thumbs.db
