{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "Codeless",
  "version": "0.0.0",
  "identifier": "dev.codeless.desktop",
  "build": {
    "frontendDist": "../../ui/codeless-ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm -C ../../ui/codeless-ui dev",
    "beforeBuildCommand": "pnpm -C ../../ui/codeless-ui build"
  },
  "app": {
    "windows": [
      {
        "title": "Codeless",
        "width": 1400,
        "height": 900,
        "url": "index.desktop.html"
      }
    ],
    "security": {
      "csp": null
    }
  }
}
