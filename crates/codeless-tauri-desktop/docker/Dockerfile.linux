# Linux build image for codeless-tauri-desktop
# Build context must be the workspace root (codeless-workspace/)
#
# Usage:
#   docker build -f codeless/crates/codeless-tauri-desktop/docker/Dockerfile.linux \
#     -t codeless-desktop-linux .

FROM rust:1.78-bookworm AS builder

# System deps required by Tauri 2 on Linux (webkit2gtk, libsoup, dbus, etc.)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libwebkit2gtk-4.1-dev \
    libsoup-3.0-dev \
    libdbus-1-dev \
    libappindicator3-dev \
    librsvg2-dev \
    patchelf \
    pkg-config \
    libssl-dev \
    libgtk-3-dev \
    libglib2.0-dev \
    libjavascriptcoregtk-4.1-dev \
    curl \
    wget \
    file \
    && rm -rf /var/lib/apt/lists/*

# Node.js + pnpm for building the UI
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y nodejs \
    && npm install -g pnpm@9 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

# Copy the full workspace (ai-runner + codeless)
COPY ai-runner/ /build/ai-runner/
COPY codeless/ /build/codeless/

# Build the UI frontend
WORKDIR /build/codeless/ui/codeless-ui
RUN pnpm install --frozen-lockfile && pnpm build

# Build the Rust binary
WORKDIR /build/codeless
RUN cargo build --release -p codeless-tauri-desktop

# Output stage — just the binary
FROM debian:bookworm-slim AS output

RUN apt-get update && apt-get install -y --no-install-recommends \
    libwebkit2gtk-4.1-0 \
    libsoup-3.0-0 \
    libdbus-1-3 \
    libappindicator3-1 \
    librsvg2-2 \
    libssl3 \
    libgtk-3-0 \
    libglib2.0-0 \
    libjavascriptcoregtk-4.1-0 \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /build/codeless/target/release/codeless-tauri-desktop /usr/local/bin/codeless-tauri-desktop

ENTRYPOINT ["codeless-tauri-desktop"]
